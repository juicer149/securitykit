# SecurityKit .env.example
# Do NOT commit real secrets. Copy this file to `.env` and adjust values locally.
# `.env.local` may be generated by the bootstrap flow when AUTO_BENCHMARK=1 and should not be committed.

# ==========================
# Core selection
# ==========================
# Select which hashing algorithm variant to use. Supported values depend on what is installed/registered.
# Variants:
#   - argon2           (requires argon2-cffi; install: securitykit[alg_argon2])
#   - bcrypt           (requires bcrypt;      install: securitykit[alg_bcrypt])
#   - scrypt           (uses hashlib; no extra dependency)
#   - werkzeug_pbkdf2  (requires Werkzeug;    install: securitykit[alg_werkzeug])
HASH_VARIANT=scrypt

# ==========================
# Argon2id Parameters (used when HASH_VARIANT=argon2)
# ==========================
# OWASP guidance (recent):
# - time_cost >= 2
# - memory_cost >= 19 MB (≈ 19456 KiB)
# - parallelism >= 1
# - hash_length >= 32
# - salt_length >= 16
#
# Note:
# - The benchmark engine only auto-tunes: time_cost, memory_cost, parallelism.
# - hash_length and salt_length are static and not auto-tuned.
# - Bootstrap/benchmark export NEVER includes any PEPPER_* keys.
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST=65536     # KiB (64 MB)
# ARGON2_PARALLELISM=2
# ARGON2_HASH_LENGTH=32
# ARGON2_SALT_LENGTH=16

# ==========================
# bcrypt Parameters (used when HASH_VARIANT=bcrypt)
# ==========================
# Cost factor (aka "rounds"). Typical baseline: 10–12 (raise for stronger hardware).
# BCRYPT_ROUNDS=12

# ==========================
# scrypt Parameters (used when HASH_VARIANT=scrypt)
# ==========================
# n must be a power of two. Keep within resource-friendly bounds for your host.
SCRYPT_N=16384
SCRYPT_R=8
SCRYPT_P=1
SCRYPT_SALT_LENGTH=16
SCRYPT_HASH_LENGTH=32
# OpenSSL scrypt memory cap (bytes). Default is 512 MiB if unset.
# Increase if you see "[digital envelope routines] memory limit exceeded".
# SCRYPT_MAXMEM=536870912

# ==========================
# Werkzeug PBKDF2 Parameters (used when HASH_VARIANT=werkzeug_pbkdf2)
# ==========================
# WERKZEUG_PBKDF2_METHOD=pbkdf2:sha256
# WERKZEUG_PBKDF2_ITERATIONS=260000
# WERKZEUG_PBKDF2_SALT_LENGTH=16

# ==========================
# Pepper (Global)
# ==========================
# SecurityKit applies pepper via a centralized subsystem before hashing.
# Modes:
# - noop            : no change
# - prefix          : prefix + password
# - suffix          : password + suffix
# - prefix_suffix   : prefix + password + suffix
# - interleave      : insert token every N chars (obfuscation)
# - hmac            : hex(HMAC(key, password))  [cryptographic]
#
# IMPORTANT:
# - Only 'hmac' provides cryptographic strengthening.
# - Bootstrap/benchmark exports NEVER include PEPPER_* keys.
# - Do NOT commit real secrets.
PEPPER_ENABLED=true
PEPPER_MODE=hmac
# HMAC mode settings (required for mode=hmac)
PEPPER_HMAC_KEY=your-strong-secret-key-here
PEPPER_HMAC_ALGO=sha256
# Prefix/suffix examples:
# PEPPER_PREFIX=[PEPPERED]
# PEPPER_SUFFIX=[SALT]
# Interleave examples:
# PEPPER_INTERLEAVE_FREQ=2
# PEPPER_INTERLEAVE_TOKEN=*

# ==========================
# Password Policy
# ==========================
# Hard enforcement rules (mandatory).
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
# Soft complexity scoring (1..5 signals: length, upper, lower, digit, special).
PASSWORD_COMPLEXITY_RULE=3
PASSWORD_COMPLEXITY_MIN_LENGTH=12

# ==========================
# Bootstrap / Benchmark (Optional)
# ==========================
# AUTO_BENCHMARK:
#   If 1 AND required hashing params are incomplete, SecurityKit runs the benchmark
#   at startup and writes tuned parameters to .env.local (with integrity metadata).
# AUTO_BENCHMARK_TARGET_MS:
#   Desired median hashing time in milliseconds (benchmark target).
# SECURITYKIT_DISABLE_BOOTSTRAP:
#   If 1, skips all automatic bootstrap logic (no benchmarking, no env generation).
# SECURITYKIT_ENV:
#   Controls log severity when configuration is incomplete (e.g., production/development).
AUTO_BENCHMARK=0
AUTO_BENCHMARK_TARGET_MS=250
SECURITYKIT_DISABLE_BOOTSTRAP=0
SECURITYKIT_ENV=development

# ==========================
# Generated metadata (added by bootstrap; reference only)
# ==========================
# GENERATED_BY=securitykit-bench vX.Y.Z
# GENERATED_SHA256=<integrity-hash>

# ==========================
# Notes
# ==========================
# 1) Development:
#    - You can temporarily set AUTO_BENCHMARK=1 to generate .env.local once,
#      then revert to AUTO_BENCHMARK=0. Do not commit .env.local.
# 2) Production:
#    - Explicitly define hashing parameters; keep AUTO_BENCHMARK=0.
#    - Use PEPPER_MODE=hmac with a strong PEPPER_HMAC_KEY.
# 3) Rotation:
#    - Plan pepper rotation and rehash strategy (login-triggered or batch).
# 4) Password complexity:
#    - Adjust PASSWORD_COMPLEXITY_RULE to raise/lower strength requirements.
#    - Use PASSWORD_COMPLEXITY_MIN_LENGTH to encourage longer passphrases.
